# ============================================================================
# Set for Life — Environment Template
# PRD §30B: "Production secrets live only in protected environment variables.
#            Never commit .env values, service-role keys, GHL credentials, or
#            participant exports."
# PRD §24:   "Browser/client code must never receive database service-role
#            secrets, GHL private credentials, or other privileged keys."
#
# Copy to .env.local and fill in. .env* is gitignored — keep it that way.
# ============================================================================

# --- Supabase -------------------------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser. NEVER put a service-role
# key behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never imported into client components. Never prefixed
# NEXT_PUBLIC_. Guarded by RLS (§24) — this key bypasses RLS, so it must
# only ever be used in server-side code paths.
SUPABASE_SERVICE_ROLE_KEY=

# Migrations only (session-mode pooler). Not used at runtime.
SUPABASE_DIRECT_URL=
SUPABASE_DATABASE_URL=

# --- GoHighLevel (PRD §30C) ----------------------------------------------
# Server-only. Private integration token — never exposed to the browser.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# --- Internal (PRD §23.5) ----------------------------------------------------
# Server-only bearer token gating the protected internal routes
# (POST /api/internal/test-harness/run, GET /api/internal/session/:id/audit).
# Never prefixed NEXT_PUBLIC_. When unset, those routes return 404 so an
# unconfigured deployment does not advertise that they exist.
INTERNAL_HARNESS_TOKEN=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign reminder links so they are not permanent
# unauthenticated access to financial data (PRD §30D).
REMINDER_LINK_SECRET=

# --- Assessment version pinning (PRD §22.6, §29 "Version pinning") --------
# A completed session must retain the versions used at completion even after
# a later version publishes.
ASSESSMENT_VERSION=1.0
SCORING_VERSION=1.0
NARRATIVE_VERSION=1.0
